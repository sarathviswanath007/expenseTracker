# Copy this file to .env.local and fill in real values from your Supabase project.
# Never commit .env.local or share these values publicly.

# Found in Supabase dashboard: Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Found in Supabase dashboard: Project Settings -> API Keys -> anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional. Enables the AI optimisation suggestions on the Insights page.
# Create a key at https://console.anthropic.com/settings/keys
# Server-side only — never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
